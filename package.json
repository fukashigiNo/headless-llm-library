{
  "name": "@fukashigiNo/headless-llm",
  "version": "0.1.1",
  "description": "UI-agnostic hooks and utilities for LLM streams and smart auto-scrolling (React, Vue, Angular)",
  "license": "MIT",
  "author": "Bekarys Barys (fukashigiNo)",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/react.cjs",
  "module": "./dist/react.js",
  "types": "./dist/react.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "react",
    "vue",
    "angular",
    "llm",
    "chatgpt",
    "streaming",
    "auto-scroll",
    "headless",
    "ai"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": "^3.0.0",
    "@angular/core": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^21.2.22",
    "@swc/core": "^1.16.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.13.2",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.4.5",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "sideEffects": false
}